@page "/pokemon"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Pokedex.Services
@using Pokedex.PokemonData
@inject PokeApiService PokeApi

<h3>Pokémon Search</h3>

<input class="inputPokemon" @bind="searchTerm" placeholder="Enter Pokémon name or ID" />
<button @onclick="SearchPokemon">Search</button>

<h4>All Pokémon</h4>

<input @bind="pokemonListFilter" placeholder="Filter Pokémon list..." />

<div style="max-height: 300px; overflow-y: auto; border: 1px solid #ccc; padding: 10px; margin-top: 10px;">
    @foreach (var pokemonItem in allPokemon
        .Where(p => string.IsNullOrWhiteSpace(pokemonListFilter) 
            || p.Name.Contains(pokemonListFilter.Trim().ToLower()))
        .OrderBy(p => p.Name))
    {
        <button type="button"
                @onclick="() => SelectPokemon(pokemonItem.Name)"
                style="display: block; margin-bottom: 5px;">
            @pokemonItem.Name
        </button>
    }
</div>

<style>
    .inputPokemon{
        width: 250px;
    }
</style>
@if (isLoading)
{
    <p>Loading...</p>
}
else if (pokemon is not null)
{
    <h4>@pokemon.Name</h4>
    <p>ID: @pokemon.Id</p>
    <p>Height: @pokemon.Height</p>
    <p>Weight: @pokemon.Weight</p>

     @if (pokemon.Types.Count > 0)
    {
        <p>Types:</p>

        <div>
            @foreach (var typeSlot in pokemon.Types)
            {
                <span style="margin-right: 8px; padding: 4px 8px; border: 1px solid black; border-radius: 8px;">
                    @typeSlot.Type.Name
                </span>
            }
        </div>
    }


    @if (pokemon.Stats.Count > 0)
    {
        <h4>Stats</h4>

        <ul>
            @foreach (var statSlot in pokemon.Stats)
            {
                <li>
                    @FormatStatName(statSlot.Stat.Name): @statSlot.BaseStat
                </li>
            }
        </ul>
    }

    @if (pokemon.Abilities.Count > 0)
    {
        <p>Abilities:</p>

        <ul>
            @foreach (var abilitySlot in pokemon.Abilities)
            {
                <li>
                    @abilitySlot.Ability.Name

                    @if (abilitySlot.IsHidden)
                    {
                        <span> - Hidden Ability</span>
                    }
                </li>
            }
        </ul>
    }
    
    @if (species is not null)
    {
        <h4>Species Info</h4>
        var englishGenus = species.Genera
            .FirstOrDefault(g => g.Language.Name == "en")
            ?.Genus;

        if (!string.IsNullOrEmpty(englishGenus))
        {
            <p>Category: @englishGenus</p>
        }

        var flavorTextEntries = species.FlavorTextEntries
        .Where(entry => entry.Language.Name == "en")
        .Select(entry => entry.FlavorText
        .Replace("\n", " ")
        .Replace("\f", " "))
        .Distinct()
        .Take(4)
        .ToList();

        if (flavorTextEntries.Count > 0)
        {
            <h4>Pokédex Descriptions</h4>

            <ul>
            @foreach (var entry in flavorTextEntries)
            {
                <li>@entry</li>
            }
            </ul>
        }
    }

    @if (!string.IsNullOrEmpty(pokemon.Sprites.FrontDefault))
    {
        <img src="@pokemon.Sprites.Other.OfficialArtwork.FrontDefault" alt="@pokemon.Name" style="width: 250px" />
    }

    @if (evolutionNames.Count > 0)
    {
        <h4>Evolution Chain</h4>
        <ul>
            @foreach (var evolutionName in evolutionNames)
            {
                <li>@evolutionName</li>
            }
        </ul>
    }
}
else if (hasSearched)
{
    <p>No Pokémon found.</p>
}

@code 
{
    private string searchTerm;
    private Pokemon? pokemon;
    private bool isLoading = false;
    private bool hasSearched = false;
    private PokemonSpecies? species;
    private List<string> evolutionNames = new();

    private List<PokemonListItem> allPokemon = new();
    private string pokemonListFilter = "";

    protected override async Task OnInitializedAsync()
    {
        allPokemon = await PokeApi.GetAllPokemonAsync();
    }

    private async Task SelectPokemon(string PokemonName)
    {
        searchTerm = PokemonName;
        await SearchPokemon();
    }

    private async Task SearchPokemon()
    {
        isLoading = true;
        hasSearched = true;
        pokemon = null;
        species = null;
        evolutionNames.Clear();

        try
        {
            pokemon = await PokeApi.GetPokemonAsync(searchTerm);
            species = await PokeApi.GetPokemonSpeciesAsync(searchTerm);

            if (species is not null && !string.IsNullOrEmpty(species.EvolutionChain.Url))
            {
                var EvolutionChain = await PokeApi.GetEvolutionChainAsync(species.EvolutionChain.Url);

                if(EvolutionChain is not null)
                {
                    evolutionNames = GetEvolutionNames(EvolutionChain.Chain);
                }
            }
        }
        catch
        {
            pokemon = null;
            species = null;
        }

        isLoading = false;
    }

    private List<string> GetEvolutionNames(EvolutionChainLink chainLink)
    {
        var names = new List<string>();

        names.Add(chainLink.Species.Name);

        foreach (var evolution in chainLink.EvolvesTo)
        {
            names.AddRange(GetEvolutionNames(evolution));
        }

        return names;
    }

    private string FormatStatName(string statName)
    {
        return statName switch
        {
            "hp" => "HP",
            "attack" => "Attack",
            "defense" => "Defense",
            "special-attack" => "Special Attack",
            "special-defense" => "Special Defense",
            "speed" => "Speed",
            _   => statName
        };
    }
}