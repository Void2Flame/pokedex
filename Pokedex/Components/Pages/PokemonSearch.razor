@page "/"
@rendermode InteractiveServer
@using Pokedex.Services
@using Pokedex.PokemonData
@inject PokeApiService PokeApi
<div class="WebContainer" style="background-color: @GetPokemonBackgroundColor();">
    <div class="NavContainer">
        <input class="inputPokemon" @bind="searchTerm" @bind:event="oninput"
               placeholder="Enter Pokémon name or ID..." />

        <div class="listContainer">
            @foreach (var pokemonItem in allPokemon
                .Where(p => string.IsNullOrWhiteSpace(searchTerm)
                    || p.Name.Contains(searchTerm.Trim().ToLower()))
                .OrderBy(p => p.Name))
            {
                <button type="button" class="pokedexList" @onclick="() => SelectPokemon(pokemonItem.Name)"
                        style="display: block; margin-bottom: 5px;">
                    @pokemonItem.Name
                </button>
            }
        </div>
    </div>
    <div class=container>
        @if (pokemon is null)
        {
            <h3 style="color: #101828;">Pokémon Search</h3>
        }
        @if (isLoading)
        {
            <p>Loading...</p>
        }
        else if (pokemon is not null)
        {
            var englishGenus = species.Genera
                       .FirstOrDefault(g => g.Language.Name == "en")
                       ?.Genus;

            <div class="firstPokeInfo">
                <div style="display: flex; flex-direction: column; justify-content: space-between;">
                    <div class="pokeAbiltiesAndInfo">
                        <p>#@pokemon.Id</p>
                        <h1>@pokemon.Name</h1>

                   
                        <p>The @englishGenus</p>

                        <div class="pokeHeightAndWeight">
                            <p>Height: @pokemon.Height</p>
                            <p>Weight: @pokemon.Weight</p>
                        </div>

                    </div>
                    @if (pokemon.Abilities.Count > 0)
                    {
                        <div>
                            <p>Abilities:</p>

                            <ul style="border-style: none; padding-left: 0px;">
                                @foreach (var abilitySlot in pokemon.Abilities)
                                {
                                    <li class="badge">
                                        @abilitySlot.Ability.Name

                                        @if (abilitySlot.IsHidden)
                                        {
                                            <span> - Hidden Ability</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>

                    }
                </div>

                <div>
                    @if (!string.IsNullOrEmpty(pokemon.Sprites.FrontDefault))
                    {
                        <img class="pokeIMG" src="@pokemon.Sprites.Other.OfficialArtwork.FrontDefault" alt="@pokemon.Name" />
                    }
                </div>
                <div>
                    @if (pokemon.Types.Count > 0)
                    {
                        <div class="pokeTypes">
                            @foreach (var typeSlot in pokemon.Types)
                            {
                                <div>
                                    <img src="@($"images/{typeSlot.Type.Name}.png")"/>
                                </div>
                                    
                            }
                        </div>
                    }
                    <h1>Base stats:</h1>
                    @if (pokemon.Stats.Count > 0)
                    {
                        <div>
                            <ul>
                                @foreach (var statSlot in pokemon.Stats)
                                {
                                    <li class="badge">
                                        @FormatStatName(statSlot.Stat.Name): @statSlot.BaseStat
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>


                
            @if (species is not null)
            {

                    
                var flavorTextEntries = species.FlavorTextEntries
                                    .Where(entry => entry.Language.Name == "en")
                                    .Select(entry => entry.FlavorText
                                    .Replace("\n", " ")
                                    .Replace("\f", " "))
                                    .Distinct()
                                    .Take(4)
                                    .ToList();

                if (flavorTextEntries.Count > 0)
                {
                    <div>
                        <h1>Pokédex Entress</h1>

                        <ul>
                            @foreach (var entry in flavorTextEntries)
                            {
                                <li>@entry</li>
                            }
                        </ul>
                    </div>

                }
            }

            @if (evolutionNames.Count > 0)
            {
                <div>
                    <h1>Evolutions</h1>
                    <div class="evolutionContainer">
                        @foreach (var evolution in evolutionPicture)
                        {
                            <div style="text-align: center; font-size: 32px">
                                <div class="evolutionCard">
                                    @if (!string.IsNullOrEmpty(evolution.ImageUrl))
                                    {
                                        <img src="@evolution.ImageUrl" alt="@evolution.Name" class="evolutionImage" />
                                    }
                                </div>
                                <p>@evolution.Name</p>
                            </div>
                        }
                    </div>

                </div>

            }
        }
        else if (hasSearched)
        {
            <p style="color: #101828;">No Pokémon found.</p>
        }
    </div>
</div>


@code
{
    private string searchTerm;
    private Pokemon? pokemon;
    private bool isLoading = false;
    private bool hasSearched = false;
    private PokemonSpecies? species;
    private List<string> evolutionNames = new();

    private List<EvolutionDisplayItem> evolutionPicture = new ();

    private List<PokemonListItem> allPokemon = new();
    private string pokemonListFilter = "";

    protected override async Task OnInitializedAsync()
    {
        allPokemon = await PokeApi.GetAllPokemonAsync();
    }

    private async Task SelectPokemon(string PokemonName)
    {
        searchTerm = PokemonName;
        await SearchPokemon();
    }

    private async Task SearchPokemon()
    {
        isLoading = true;
        hasSearched = true;
        pokemon = null;
        species = null;
        evolutionNames.Clear();

        try
        {
            pokemon = await PokeApi.GetPokemonAsync(searchTerm);
            species = await PokeApi.GetPokemonSpeciesAsync(searchTerm);

            pokemon.Name=FirstLetterToUpper(pokemon.Name);

            if (species is not null && !string.IsNullOrEmpty(species.EvolutionChain.Url))
            {
                var EvolutionChain = await PokeApi.GetEvolutionChainAsync(species.EvolutionChain.Url);

                if (EvolutionChain is not null)
                {
                    evolutionNames = GetEvolutionNames(EvolutionChain.Chain);
                    evolutionPicture.Clear();

                    foreach(var evolutionName in evolutionNames)
                    {
                        var evoltuionPokemon = await PokeApi.GetPokemonAsync(evolutionName);
                        {
                            if (evoltuionPokemon is not null)
                            {
                                var imageUrl = evoltuionPokemon.Sprites.Other.OfficialArtwork.FrontDefault
                                ?? evoltuionPokemon.Sprites.FrontDefault;

                                evolutionPicture.Add(new EvolutionDisplayItem
                                {
                                    Name = evoltuionPokemon.Name,
                                    ImageUrl = imageUrl
                                });
                            }
                        }
                    }
                }
            }
        }
        catch
        {
            pokemon = null;
            species = null;
        }

        isLoading = false;
    }

    private List<string> GetEvolutionNames(EvolutionChainLink chainLink)
    {
        var names = new List<string>();

        names.Add(chainLink.Species.Name);

        foreach (var evolution in chainLink.EvolvesTo)
        {
            names.AddRange(GetEvolutionNames(evolution));
        }

        return names;
    }

    public string FirstLetterToUpper(string str)
{
    if (str == null)
        return null;

    if (str.Length > 1)
        return char.ToUpper(str[0]) + str.Substring(1);

    return str.ToUpper();
}

    private string FormatStatName(string statName)
    {
        return statName switch
        {
            "hp" => "HP",
            "attack" => "Attack",
            "defense" => "Defense",
            "special-attack" => "Special Attack",
            "special-defense" => "Special Defense",
            "speed" => "Speed",
            _ => statName
        };
    }

public class EvolutionDisplayItem
{
    public string Name { get; set; } = "";
    public string? ImageUrl { get; set; }
}

    private string GetPokemonBackgroundColor()
{
    if (species?.Color?.Name is null)
    {
        return "#F9FAFB";
    }

    return species.Color.Name switch
    {
        "black" => "#353535",
        "blue" => "#1A4885",
        "brown" => "#9C7551",
        "gray" => "#A3A3A3",
        "green" => "#32752B",
        "pink" => "#7D004D",
        "purple" => "#551B51",
        "red" => "#691618",
        "white" => "#A3A3A3",
        "yellow" => "#8A7500",
        _ => "#f5f5f5"
    };
}
}